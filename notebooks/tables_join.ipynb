    "\n",
    "import pandas as pd\n",
    "\n",
    "# Step 1: Merge film and inventory\n",
    "merged_df = pd.merge(film_df, inventory_df.drop(columns=[\"last_update\"], errors=\"ignore\"), on=\"film_id\", how=\"inner\")\n",
    "merged_df = pd.merge(merged_df, rental_df.drop(columns=[\"last_update\"], errors=\"ignore\"), on=\"inventory_id\", how=\"inner\")\n",
    "merged_df = pd.merge(merged_df, payment_df.drop(columns=[\"last_update\"], errors=\"ignore\"), on=\"rental_id\", how=\"inner\")\n",
    "\n",
    "# Step 3: Aggregate - count customers per country\n",
    "agg_df = (\n",
    "    merged_df.groupby(\"title\", as_index=False)\n",
    "    .agg({\"amount\": \"sum\"})\n",
    "    .rename(columns={\"amount\": \"total_revenue\"})\n",
    ")\n",
    "\n",
    "# Step 4: Order results (descending by customer count)\n",
    "agg_df = agg_df.sort_values(by=\"total_revenue\", ascending=False)\n",
    "\n",
    "print(agg_df)\n",
    "\n",
    "\n"
   ]
  }
